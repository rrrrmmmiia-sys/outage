# توکن ربات تلگرام (از BotFather بگیر)
TELEGRAM_BOT_TOKEN=

# ریلوی به‌صورت خودکار این متغیر رو موقع اضافه‌کردن پلاگین PostgreSQL می‌سازه
# فرمت باید با +asyncpg باشه، اگه ریلوی postgresql:// داد، خودت prefix رو اضافه کن
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# منطقه‌ی زمانی برای محاسبه‌ی ساعت قطعی و زمان‌بندی کارها
TIMEZONE=Asia/Tehran

# حداکثر تعداد مکان مجاز برای هر کاربر
MAX_LOCATIONS_PER_USER=3

# چند دقیقه قبل از شروع قطعی به کاربر هشدار داده بشه
NOTIFY_MINUTES_BEFORE=10
